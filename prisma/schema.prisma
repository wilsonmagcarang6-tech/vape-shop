generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model admin {
  AdminID  Int      @id @default(autoincrement())
  username String   @unique
  password String
  billings billing[]
}

model cashier {
  CashierID Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  fullName  String?
  createdAt DateTime  @default(now())
  billings  billing[]
}

model product {
  ProductID    Int           @id @default(autoincrement())
  ProductName  String
  CostPrice    Decimal       @db.Decimal(10, 2)
  SellingPrice Decimal       @db.Decimal(10, 2)
  Quantity     Int
  ReorderPoint Int           @default(5)
  createdAt    DateTime      @default(now())
  PictureURL   String?
  transactions transaction[]
}

model billing {
  BillingID    Int           @id @default(autoincrement())
  CustomerName String?
  TotalAmount  Decimal       @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  CashierID    Int?
  AdminID      Int?
  cashier      cashier?      @relation(fields: [CashierID], references: [CashierID])
  admin        admin?        @relation(fields: [AdminID], references: [AdminID])
  payments     payment[]
  transactions transaction[]

  @@index([CashierID])
  @@index([AdminID])
}

model transaction {
  TransactionID Int      @id @default(autoincrement())
  ProductID     Int
  BillingID     Int
  Qty           Int
  CostPrice     Decimal  @db.Decimal(10, 2)
  SellingPrice  Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  billing       billing  @relation(fields: [BillingID], references: [BillingID])
  product       product  @relation(fields: [ProductID], references: [ProductID])

  @@index([ProductID])
  @@index([BillingID])
}

model payment {
  PaymentID Int      @id @default(autoincrement())
  BillingID Int
  Amount    Decimal  @db.Decimal(10, 2)
  Method    method
  createdAt DateTime @default(now())
  billing   billing  @relation(fields: [BillingID], references: [BillingID])

  @@index([BillingID])
}

model AiInsight {
  id        Int      @id @default(autoincrement())
  category  String   // e.g., 'sales', 'inventory', 'general'
  title     String
  message   String   @db.Text
  severity  String   @default("info") // info, warning, success, danger
  metadata  String?  @db.Text // JSON string for extra data
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
}

model SalesForecast {
  id          Int      @id @default(autoincrement())
  ProductID   Int?
  forecastDate DateTime
  predictedQty Float
  actualQty   Float?
  confidence  Float    @default(0.8)
  createdAt   DateTime @default(now())

  @@index([ProductID])
  @@index([forecastDate])
}

model SmsAlert {
  id          Int      @id @default(autoincrement())
  ProductID   Int?
  productName String
  message     String   @db.Text
  phoneNumber String
  status      String   @default("pending") // pending, sent, failed
  sentAt      DateTime?
  createdAt   DateTime @default(now())
}

model SmsSettings {
  id            Int      @id @default(autoincrement())
  phoneNumber   String?
  twilioSid     String?
  twilioToken   String?
  twilioPhone   String?
  alertsEnabled Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

enum method {
  Cash
  GCash
}
